# Copy to .env.local and fill what you have. Everything is optional;
# each feature degrades gracefully to existing behavior without its key.

# AI analyst (anchored scenario engine + future AI red team)
ANTHROPIC_API_KEY=
# Optional model override (default claude-sonnet-4-6)
RIPTIDE_AI_MODEL=

# Prefer live data (yahoo-finance2) for any ticker, with snapshot fallback.
# Leave unset for the demo-safe snapshot-first default.
RIPTIDE_FORCE_LIVE=

# Financial Modeling Prep: per-firm rating actions, DCF anchor, key ratios,
# analyst estimates, earnings surprises. https://site.financialmodelingprep.com/
FMP_API_KEY=

# FRED (St. Louis Fed): live 3-month Treasury yield as the risk-free rate.
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Finnhub: quotes, news, recommendation trends (cross-check/fallback). https://finnhub.io/
FINNHUB_API_KEY=

# Alpha Vantage: EOD historical options (25 req/day). https://www.alphavantage.co/
ALPHAVANTAGE_API_KEY=
